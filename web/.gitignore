# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dữ liệu chạy thật: database, file tải lên, mật khẩu admin ban đầu
/data/

# dữ liệu chạy thật và bản sao lưu trước khi viết lại bước 1
/data.step1-backup/

# kết quả test
/test-results/
/playwright-report/
